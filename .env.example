# Скопируйте этот файл в .env и заполните ссылку и код доступа.

# Доступ
EMIAS_URL=
EMIAS_CODE=

# Браузер: chrome или chromium. 1 = без окна
EMIAS_BROWSER=chrome
EMIAS_HEADLESS=0
EMIAS_SLOW_MO=10

# Папка для PDF. Пустое значение = downloads рядом со сценарием
EMIAS_OUTPUT_DIR=

# Только указанные разделы через запятую, например: анализы,приёмы
EMIAS_ONLY=

# 1 = только разложить уже скачанные файлы по папкам, без браузера
EMIAS_ORGANIZE_ONLY=0

# Паузы, лимиты и перезапуск Chrome
EMIAS_MAX_PAGES=250
EMIAS_EVENT_SETTLE_MS=350
EMIAS_ACTION_DELAY_MS=600
EMIAS_RESTART_EVERY=20
EMIAS_DOCUMENT_LOAD_DELAY_MS=1000
EMIAS_MODAL_APPEAR_TIMEOUT_MS=4000
